{
  "name": "ascii-sharks-readme-video",
  "private": true,
  "scripts": {
    "prepare-assets": "bun scripts/prepare-assets.ts",
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx MacDesktop ../../docs/assets/macos-desktop.mp4 --codec=h264 --crf=16 --image-format=png --disable-shared-memory-capture --concurrency=2",
    "gif": "remotion render src/index.tsx MacDesktop ../../output/readme/remotion-desktop-source.gif --codec=gif --every-nth-frame=2 --scale=0.8 --image-format=png --disable-shared-memory-capture --concurrency=2",
    "still": "remotion still src/index.tsx MacDesktop ../../output/readme/remotion-desktop.png --frame=60",
    "check": "bun scripts/check-media.ts"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.540",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.540"
  }
}
